# Copy this file to .env and fill in your own values. Never commit .env!

# Slack (from api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Channel where unanswered questions go to the founder (right-click channel -> Copy link -> last part)
FOUNDER_CHANNEL_ID=C0123456789

# Grok (from console.x.ai)
XAI_API_KEY=xai-...
GROK_MODEL=grok-4

# Local storage (defaults are fine)
CHROMA_PATH=./data/chroma
METRICS_LOG=./data/question_log.csv
PENDING_PATH=./data/pending.json
